# ==============================================================================
# AtmoGraph Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="AtmoGraph Ripple Predictor"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
API_PREFIX="/api/v1"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Structured Logging Configuration
LOG_LEVEL="INFO"
LOG_JSON_FORMAT=true
REQUEST_ID_HEADER="X-Request-ID"

# Graph Database Connection (Neo4j)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"
NEO4J_DATABASE="neo4j"
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=5.0

# NLP & GNN Bridge Settings
NLP_WEBHOOK_SECRET="atmo-graph-secret-key-change-in-prod"
GNN_MODEL_PATH="models/gnn_ripple_predictor.pt"
GNN_DEVICE="cpu"
