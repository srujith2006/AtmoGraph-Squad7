# ==============================================================================
# AtmoGraph Frontend: Multi-Stage Production Dockerfile
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Vite & React UI Builder
# ------------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Cache package dependencies
COPY package*.json ./
RUN npm ci

# Copy frontend source files and static assets
COPY index.html vite.config.js postcss.config.js tailwind.config.js ./
COPY src/ ./src/
COPY public/ ./public/

# Build optimized production bundle to /app/dist
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 2: Minimal High-Performance Nginx Web Server
# ------------------------------------------------------------------------------
FROM nginx:1.25-alpine AS runner

# Remove default boilerplate configuration
RUN rm -rf /etc/nginx/conf.d/*

# Copy custom Nginx SPA routing and reverse-proxy configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy production static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose HTTP port
EXPOSE 80

# Health check to ensure Nginx server is actively responding
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# Start Nginx in foreground mode
CMD ["nginx", "-g", "daemon off;"]
